{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
    "memory": {
      "command": "cmd /c npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "sequential-thinking": {
      "command": "cmd /c npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "everything": {
      "command": "cmd /c npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-everything"
      ]
    },
    "filesystem": {
      "command": "cmd /c npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:\\"
      ]
    },
    "time-mcp": {
      "command": "cmd /c npx",
      "args": ["-y", "time-mcp"]
    }
  }
}