<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jimuqu</groupId>
    <artifactId>jimuqu</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <parent>
        <groupId>org.noear</groupId>
        <artifactId>solon-parent</artifactId>
        <version>3.10.4</version>
        <relativePath/>
    </parent>

    <modules>
        <module>jimuqu-admin</module>
        <module>jimuqu-common</module>
        <module>jimuqu-modules</module>
    </modules>

    <properties>
        <!-- 项目版本 -->
        <revision>1.0.0</revision>
        <java.version>17</java.version>
        <!-- 通用 -->
        <lombok.version>1.18.42</lombok.version>
        <!-- 工具类 -->
        <hutool.version>7.0.0-M5</hutool.version>
        <!-- 第三方组件仍依赖的 Hutool 5，与 cn.hutool.v7 包名隔离 -->
        <hutool5.version>5.8.47</hutool5.version>
        <!-- 实体类转换工具 -->
        <mapstruct-plus.version>1.5.0</mapstruct-plus.version>
        <mapstruct-plus.lombok.version>0.2.0</mapstruct-plus.lombok.version>
        <!-- 数据源 -->
        <mysql.version>9.7.0</mysql.version>
        <sqlite.version>3.53.0.0</sqlite.version>
        <p6spy.version>3.9.1</p6spy.version>
        <!-- 连接池 -->
        <hikaricp.version>7.0.2</hikaricp.version>
        <!-- 实体类维护数据库表结构 -->
        <autotable.version>2.5.15</autotable.version>
        <!-- ORM 框架 -->
        <xbatis.version>1.10.1</xbatis.version>
        <!-- 权限认证框架 -->
        <sa-token.version>1.45.0</sa-token.version>
        <!-- 文件上传 -->
        <x-file-storage.version>2.3.0</x-file-storage.version>
        <minio.version>9.0.0</minio.version>
        <!-- excel -->
        <fastexcel.version>1.3.0</fastexcel.version>
        <!-- 三方认证 -->
        <justauth.version>2.0.0</justauth.version>
        <!-- 短信 -->
        <sms4j.version>3.3.5</sms4j.version>
        <!-- 邮件 -->
        <jakarta.mail.version>2.0.5</jakarta.mail.version>
        <jakarta.mail.api.version>2.1.5</jakarta.mail.api.version>

        <!-- 以下基本固定不变 -->
        <!-- 打包默认跳过测试 -->
        <skipTests>true</skipTests>
        <!-- 离线IP地址定位库 -->
        <ip2region.version>3.3.7</ip2region.version>
        <!-- 获取Java注释 -->
        <therapi-javadoc.version>0.15.0</therapi-javadoc.version>
        <!-- 编码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- 插件版本 -->
        <maven-compiler-plugin.verison>3.14.1</maven-compiler-plugin.verison>
        <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
    </properties>

    <profiles>
        <profile>
            <id>dev</id>
            <properties>
                <!-- 环境标识，需要与配置文件的名称相对应 -->
                <profiles.active>dev</profiles.active>
                <logging.level>info</logging.level>
            </properties>
            <activation>
                <!-- 默认环境 -->
                <activeByDefault>true</activeByDefault>
            </activation>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <profiles.active>prod</profiles.active>
                <logging.level>warn</logging.level>
            </properties>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <!-- common 的依赖配置-->
            <dependency>
                <groupId>com.jimuqu</groupId>
                <artifactId>jimuqu-common-bom</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- hutool 7 的依赖配置-->
            <dependency>
                <groupId>cn.hutool.v7</groupId>
                <artifactId>hutool-bom</artifactId>
                <version>${hutool.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- SMS4J、x-file-storage 等第三方组件依赖的 Hutool 5 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-bom</artifactId>
                <version>${hutool5.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- sa-token 的依赖配置-->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-bom</artifactId>
                <version>${sa-token.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-snack4</artifactId>
                <version>${sa-token.version}</version>
            </dependency>

            <!-- JustAuth 的依赖配置-->
            <dependency>
                <groupId>cn.herodotus.opensteward</groupId>
                <artifactId>JustAuth</artifactId>
                <version>${justauth.version}</version>
            </dependency>

            <!-- Excel导出 -->
            <dependency>
                <groupId>cn.idev.excel</groupId>
                <artifactId>fastexcel</artifactId>
                <version>${fastexcel.version}</version>
            </dependency>

            <!-- 内置数据库支持 -->
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite.version}</version>
            </dependency>

            <!-- Mysql驱动包 -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.version}</version>
            </dependency>

            <!-- 数据源 -->
            <dependency>
                <groupId>com.zaxxer</groupId>
                <artifactId>HikariCP</artifactId>
                <version>${hikaricp.version}</version>
            </dependency>

            <!-- 离线IP地址定位库 ip2region -->
            <dependency>
                <groupId>org.lionsoul</groupId>
                <artifactId>ip2region</artifactId>
                <version>${ip2region.version}</version>
            </dependency>

            <!-- 持久层框架 -->
            <dependency>
                <groupId>cn.xbatis</groupId>
                <artifactId>xbatis-solon-plugin</artifactId>
                <version>${xbatis.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.xbatis</groupId>
                <artifactId>xbatis-annotation</artifactId>
                <version>${xbatis.version}</version>
            </dependency>

            <!-- JavaBean维护表结构 -->
            <dependency>
                <groupId>org.dromara.autotable</groupId>
                <artifactId>auto-table-solon-plugin</artifactId>
                <version>${autotable.version}</version>
            </dependency>

            <!-- 获取代码文本注释 -->
            <dependency>
                <groupId>com.github.therapi</groupId>
                <artifactId>therapi-runtime-javadoc</artifactId>
                <version>${therapi-javadoc.version}</version>
            </dependency>

            <!-- 文件存储 -->
            <dependency>
                <groupId>org.dromara.x-file-storage</groupId>
                <artifactId>x-file-storage-solon</artifactId>
                <version>${x-file-storage.version}</version>
            </dependency>
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>

            <!-- 系统的功能模块 -->
            <dependency>
                <groupId>com.jimuqu</groupId>
                <artifactId>jimuqu-system</artifactId>
                <version>${revision}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.verison}</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.github.therapi</groupId>
                            <artifactId>therapi-runtime-javadoc-scribe</artifactId>
                            <version>${therapi-javadoc.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>io.github.linpeilie</groupId>
                            <artifactId>mapstruct-plus-processor</artifactId>
                            <version>${mapstruct-plus.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${mapstruct-plus.lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-parameters</arg>
                        <arg>
                            -Amapstruct.defaultComponentModel=solon
                        </arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!-- 统一版本号管理 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- 关闭过滤 -->
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <!-- 引入所有 匹配文件进行过滤 -->
                <includes>
                    <include>*.yml</include>
                </includes>
                <!-- 启用过滤 即该资源中的变量将会被过滤器中的值替换 -->
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>


    <repositories>
        <repository>
            <id>public</id>
            <name>huawei nexus</name>
            <url>https://mirrors.huaweicloud.com/repository/maven/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>public</id>
            <name>huawei nexus</name>
            <url>https://mirrors.huaweicloud.com/repository/maven/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

</project>
